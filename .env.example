# Обязательно: токен вашего бота, выдаёт @BotFather в Telegram.
BOT_TOKEN=

# Обязательно: ключ для распознавания трат по тексту/голосу/фото.
# Бесплатный ключ Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Необязательно: ADMIN_CHAT_ID можно вообще не трогать — первый, кто
# напишет свежеустановленному боту /start, автоматически станет
# администратором. Задавайте здесь только если хотите закрепить админа
# заранее (например, при переносе уже работающей установки на другой сервер).
ADMIN_CHAT_ID=

# Необязательно: запасной провайдер распознавания на случай, если Gemini
# недоступен (лимиты/сбой). LLM_PROVIDER=gemini или deepseek — какой из
# двух пробовать первым (по умолчанию gemini).
# DEEPSEEK_API_KEY=
# LLM_PROVIDER=gemini

# Необязательно: публичный HTTPS-адрес мини-аппа (webapp_server.py) — нужен,
# чтобы в Telegram открывалась кнопка мини-аппа. Проще всего получить через
# cloudflared quick tunnel (см. INSTALL.md), адрес меняется при каждом
# перезапуске туннеля.
# EXPERIMENTAL_MINIAPP_URL=
